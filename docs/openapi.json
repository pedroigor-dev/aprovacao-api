  "info": {
    "title": "aprovacao-api",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bootstrap": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Bootstrap-Key"
      },
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateExpense": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "Passagem para visita ao cliente"
          },
          "amountCents": {
            "type": "number",
            "example": 15000,
            "description": "Valor em centavos de BRL"
          }
        },
        "required": [
          "description",
          "amountCents"
        ]
      },
      "VersionCommand": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "example": 0
          }
        },
        "required": [
          "version"
        ]
      },
      "ProvisionUser": {
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "example": "empresa-a"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "example": "Senha-local-segura-123!"
          },
          "role": {
            "type": "string",
            "enum": [
              "requester",
              "approver",
              "finance",
              "auditor"
            ]
          }
        },
        "required": [
          "tenant",
          "email",
          "password",
          "role"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "example": "empresa-a"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "example": "Senha-local-segura-123!"
          }
        },
        "required": [
          "tenant",
          "email",
          "password"
        ]
      }
    }
  }
